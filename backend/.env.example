# ==============================================================================
# SourceIQ Backend Configuration (.env)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="SourceIQ"
API_V1_STR="/api/v1"

# Server Bind Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# PostgreSQL Connection with pgvector
# Local Windows native connection
DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5432/sourceiq_db

# Local File Storage
STORAGE_LOCAL_DIR=./data/uploads
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_MIME_TYPES="application/pdf"

# ==============================================================================
# AI Provider Architecture (Switch dynamically without changing code!)
# ==============================================================================
LLM_PROVIDER=gemini              # Options: gemini | openai | ollama
EMBEDDING_PROVIDER=gemini        # Options: gemini | openai | ollama

# Google Gemini Settings (Active Default)
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI Settings (Alternative / Future switch)
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Dimensions (768 for Gemini text-embedding-004, 1536 for OpenAI)
EMBEDDING_DIMENSIONS=768
SIMILARITY_THRESHOLD=0.48
TOP_K_RETRIEVAL=5

# Provider Timeout and Retries
PROVIDER_TIMEOUT_SECONDS=15
PROVIDER_MAX_RETRIES=3
