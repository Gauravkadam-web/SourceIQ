# ==============================================================================
# SourceIQ — Root Environment Configuration Blueprint
# ==============================================================================
# NOTE: The AI Agent will NEVER touch or create real .env files.
# Users must copy this file to .env and configure their environment values.
#
# SourceIQ enforces 3 separate environment files:
#   1. Root:     /.env.example          (Global repository & orchestration settings)
#   2. Backend:  /backend/.env.example  (FastAPI, PostgreSQL credentials, AI Provider keys)
#   3. Frontend: /frontend/.env.example (Next.js public API URLs, client limits)
# ==============================================================================

# Project Information
PROJECT_NAME="SourceIQ"
TAGLINE="AI Answers. Verifiable Sources."
ENVIRONMENT=development

# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432

# Database Target
POSTGRES_DB=sourceiq_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-db-password
